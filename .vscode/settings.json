{
  // Tailwind v4 at-rules (@plugin, @theme, @utility, @apply, @custom-variant) are unknown to
  // VS Code's built-in CSS checker. Treat .css files as Tailwind CSS (Tailwind IntelliSense
  // extension) so they're understood, and silence the plain checker as a fallback.
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "css.lint.unknownAtRules": "ignore"
}
